# Copy to .env and fill in. Never commit the real .env.

# --- Jira (collectors/) ---
# Base URL of the Jira Cloud site, e.g. https://your-org.atlassian.net
JIRA_BASE_URL=https://hirereidcollins.atlassian.net
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
# Used with your account email for Basic auth (email:token).
JIRA_API_TOKEN=
JIRA_EMAIL=

# --- Anthropic (narrative/) ---
ANTHROPIC_API_KEY=

# --- Real billing feeds (collectors/billing.py, RC1-308) ---
# Admin API key (sk-ant-admin…) — a different key class; the regular API key
# cannot read the org cost report.
ANTHROPIC_ADMIN_KEY=
# RC1-327: the Anthropic workspace eval traffic bills to — scopes the cost
# report so real-cost-per-run reads eval spend exactly, with the org total
# shipped beside it. Unset => the old org-wide read and its stated caveat.
ANTHROPIC_EVAL_WORKSPACE_ID=
# Heroku Platform API token — reads the account invoices (the store's bill).
HEROKU_API_KEY=

# --- Slack (drift/notify.py) ---
# Incoming webhook for the program-channel weekly rollup.
SLACK_WEBHOOK_URL=

# --- Runtime ---
# When true, notifications are logged instead of sent (dev/demo). See [8/9].
DRY_RUN=true
# Jira project to scan.
PROJECT_KEY=RC1
# SQLite snapshot store. On Fly.io point this at the mounted volume: /data/drift.db
DB_PATH=data/drift.db
# Shared secret gating POST /drift/run (the scheduler sends it as X-Drift-Token).
# Leave unset for an open local endpoint.
DRIFT_RUN_TOKEN=

# --- Program simulator (simulate/, RC1-299) ---
# Board whose estimation field receives story points (the PMA scrum board).
KPI_SIM_BOARD_ID=68
# Where the sim clock, manifest and spend line live (gitignored).
KPI_SIM_DIR=data/kpi-sim
