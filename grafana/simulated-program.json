{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "Postgres (reid-eval-store)",
      "description": "The database the readings land in \u2014 see docs/kpi/metrics-store.md",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    }
  ],
  "title": "KPI \u2014 simulated-program",
  "uid": "kpi-simulated-program",
  "description": "Readings for simulated-program, computed by code from dated snapshots (RC1-305). Gaps are days the KPI could not be measured; they are never drawn as zero.",
  "tags": [
    "kpi",
    "simulated-program"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now+45d"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Thresholds crossed",
      "description": "KPIs whose so-what threshold is live on the latest reading \u2014 the decision attached to the number, not the number.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"tripped\"\nFROM kpi_readings r\nJOIN (SELECT kpi_id, max(sim_date) AS d\n      FROM kpi_readings WHERE program_id = 'simulated-program' GROUP BY kpi_id) latest\n  ON latest.kpi_id = r.kpi_id AND latest.d = r.sim_date\nWHERE r.program_id = 'simulated-program' AND r.tripped"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "KPIs not measurable today",
      "description": "Stale or broken on the latest day. Anything above zero is RC1-307's.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"unmeasured\"\nFROM kpi_readings r\nJOIN (SELECT kpi_id, max(sim_date) AS d\n      FROM kpi_readings WHERE program_id = 'simulated-program' GROUP BY kpi_id) latest\n  ON latest.kpi_id = r.kpi_id AND latest.d = r.sim_date\nWHERE r.program_id = 'simulated-program' AND r.state <> 'ok'"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Latest reading per KPI",
      "description": "The most recent reading for every shipping KPI. `state` is the honesty column: stale or broken carries the reason it could not be measured, and `snapshot run` is the run the number traces back to (`python -m collectors show <program> --run N`).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "why not"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.kpi_id AS \"KPI\", r.state AS \"state\", r.value AS \"value\",\n       r.tripped AS \"tripped\", r.reason AS \"why not\", r.sim_date AS \"day\",\n       r.run_id AS \"snapshot run\"\nFROM kpi_readings r\nJOIN (SELECT kpi_id, max(sim_date) AS d\n      FROM kpi_readings WHERE program_id = 'simulated-program' GROUP BY kpi_id) latest\n  ON latest.kpi_id = r.kpi_id AND latest.d = r.sim_date\nWHERE r.program_id = 'simulated-program'\nORDER BY r.state <> 'ok' DESC, r.kpi_id"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Days",
      "description": "Forecast slip, Critical-path slack \u2014 outcome KPI: forecast-slip-days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT sim_date::timestamptz AS \"time\", kpi_id AS metric, value\nFROM kpi_readings\nWHERE program_id = 'simulated-program' AND kpi_id IN ('forecast-slip-days', 'critical-path-slack-days')\nORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost",
      "description": "Cloud cost vs envelope \u2014 outcome KPI: cost-vs-envelope.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT sim_date::timestamptz AS \"time\", kpi_id AS metric, value\nFROM kpi_readings\nWHERE program_id = 'simulated-program' AND kpi_id IN ('cost-vs-envelope')\nORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Rates and shares",
      "description": "Scope change vs baseline, Blocked share of open work on GA chains \u2014 leading indicators.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT sim_date::timestamptz AS \"time\", kpi_id AS metric, value\nFROM kpi_readings\nWHERE program_id = 'simulated-program' AND kpi_id IN ('scope-change-pct', 'blocked-share-pct')\nORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ratios",
      "description": "Weekly spend burn ratio \u2014 leading indicators.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT sim_date::timestamptz AS \"time\", kpi_id AS metric, value\nFROM kpi_readings\nWHERE program_id = 'simulated-program' AND kpi_id IN ('weekly-spend-burn-ratio')\nORDER BY 1"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
