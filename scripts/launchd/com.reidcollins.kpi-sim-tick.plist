<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily tick for the program simulator (RC1-299): advances the sim clock one
  day at 07:00 local and converges Jira. For the three-week brief run.

  Install (not done automatically — it changes what your machine does daily):
    cp scripts/launchd/com.reidcollins.kpi-sim-tick.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.reidcollins.kpi-sim-tick.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/com.reidcollins.kpi-sim-tick.plist

  Edit WorkingDirectory to the repo checkout. Logs land in data/kpi-sim/.
  For hourly ticks during development use StartInterval 3600 instead of
  StartCalendarInterval.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.reidcollins.kpi-sim-tick</string>
  <key>WorkingDirectory</key>
  <string>/Users/reidcollins/programming/personal/tpm-automation-platform</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/reidcollins/programming/personal/tpm-automation-platform/.venv/bin/python</string>
    <string>-m</string>
    <string>simulate</string>
    <string>tick</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/reidcollins/programming/personal/tpm-automation-platform/data/kpi-sim/tick.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/reidcollins/programming/personal/tpm-automation-platform/data/kpi-sim/tick.err</string>
</dict>
</plist>
