<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily snapshot of the simulated program (RC1-301): collects Jira, the spend
  line and the sim clock into the snapshot store at 07:30 local, half an hour
  after the simulator's tick (com.reidcollins.kpi-sim-tick.plist), so each
  sim-day is captured once in its converged state.

  Install (not done automatically — it changes what your machine does daily):
    cp scripts/launchd/com.reidcollins.kpi-snapshot.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.reidcollins.kpi-snapshot.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/com.reidcollins.kpi-snapshot.plist

  Edit WorkingDirectory to the repo checkout. Logs land in data/kpi-sim/.
  The eval-run-store program is not snapshotted here: it needs
  EVAL_DATABASE_URL, which lives in the shell profile and nowhere launchd
  would read it (RC1-263). See docs/kpi/snapshots.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.reidcollins.kpi-snapshot</string>
  <key>WorkingDirectory</key>
  <string>/Users/reidcollins/programming/personal/tpm-automation-platform</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/reidcollins/programming/personal/tpm-automation-platform/.venv/bin/python</string>
    <string>-m</string>
    <string>collectors</string>
    <string>snapshot</string>
    <string>simulated-program</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/reidcollins/programming/personal/tpm-automation-platform/data/kpi-sim/snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/reidcollins/programming/personal/tpm-automation-platform/data/kpi-sim/snapshot.err</string>
</dict>
</plist>
